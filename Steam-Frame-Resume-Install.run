/* Steam Frame Clean Resume: one immediate, guarded close per suspend/resume.
 * No network requests, polling, inhibitors, settings edits or shell execution.
 */
#define _GNU_SOURCE
#include <errno.h>
#include <fcntl.h>
#include <limits.h>
#include <poll.h>
#include <signal.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <spawn.h>
#include <sys/stat.h>
#include <sys/syscall.h>
#include <sys/wait.h>
#include <systemd/sd-bus.h>
#include <systemd/sd-daemon.h>
#include <time.h>
#include <unistd.h>

extern char **environ;
#define VERSION "native-0.2.0"
#define VR_COMMAND "/opt/steamvr/bin/linuxarm64/vrcmd"
#define MAX_LOG_UPDATE 131072U

struct helper {
    const char *log_path;
    int checkpoint;
    bool dry_run;
    int (*close_action)(void);
};

static void disarm(struct helper *h) {
    if (h->checkpoint >= 0)
        close(h->checkpoint);
    h->checkpoint = -1;
}

static bool same_log(int fd, const char *path, off_t minimum_size) {
    struct stat opened, named;
    return fstat(fd, &opened) == 0 && lstat(path, &named) == 0 &&
        S_ISREG(opened.st_mode) && S_ISREG(named.st_mode) &&
        opened.st_dev == named.st_dev && opened.st_ino == named.st_ino &&
        opened.st_size >= minimum_size;
}

/* Bounded streaming scan, including markers split across reads. Keep only
 * the last 63 bytes between reads; no permanent log buffer or file watcher.
 * A partial marker line is conservatively treated as dashboard use too.
 */
static bool dashboard_untouched(int fd, const char *path) {
    static const char toggle[] = "[Dashboard] [ToggleDashboard]";
    static const char hide[] = "[Dashboard] [HideDashboard]";
    off_t offset = lseek(fd, 0, SEEK_CUR);
    if (offset < 0 || !same_log(fd, path, offset))
        return false;
    char buffer[4096 + 64];
    size_t carry = 0, total = 0;
    for (;;) {
        size_t remaining = MAX_LOG_UPDATE + 1U - total;
        size_t count = remaining < 4096 ? remaining : 4096;
        ssize_t n = read(fd, buffer + carry, count);
        if (n < 0 && errno == EINTR)
            continue;
        if (n < 0)
            return false;
        if (n == 0)
            break;
        total += (size_t)n;
        if (total > MAX_LOG_UPDATE)
            return false;
        size_t length = carry + (size_t)n;
        if (memmem(buffer, length, toggle, sizeof(toggle) - 1) ||
            memmem(buffer, length, hide, sizeof(hide) - 1))
            return false;
        carry = length < 63 ? length : 63;
        memmove(buffer, buffer + length - carry, carry);
    }
    return same_log(fd, path, offset + (off_t)total);
}

static int64_t monotonic_ms(void) {
    struct timespec now;
    if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
        return -1;
    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
}

/* Wait on the exact child process, with a deadline, only while it is running.
 * pidfd polling blocks in the kernel; this is not a periodic background check.
 */
static int run_bounded(const char *path, char *const argv[], int timeout_ms) {
    posix_spawn_file_actions_t actions;
    int error = posix_spawn_file_actions_init(&actions);
    if (error)
        return -error;
    error = posix_spawn_file_actions_addopen(&actions, STDOUT_FILENO,
                                           "/dev/null", O_WRONLY, 0);
    if (!error)
        error = posix_spawn_file_actions_adddup2(&actions, STDOUT_FILENO, STDERR_FILENO);
    pid_t child = -1;
    if (!error)
        error = posix_spawn(&child, path, &actions, NULL, argv, environ);
    posix_spawn_file_actions_destroy(&actions);
    if (error)
        return -error;

    int pidfd = (int)syscall(SYS_pidfd_open, child, 0);
    int result = pidfd < 0 ? -errno : 0;
    int64_t started = monotonic_ms();
    if (started < 0 && result == 0)
        result = -EIO;
    while (result == 0) {
        int64_t now = monotonic_ms();
        if (now < 0) {
            result = -EIO;
            break;
        }
        int64_t remaining = started + timeout_ms - now;
        if (remaining <= 0) {
            result = -ETIMEDOUT;
            break;
        }
        struct pollfd watched = { .fd = pidfd, .events = POLLIN };
        int n = poll(&watched, 1, remaining > INT_MAX ? INT_MAX : (int)remaining);
        if (n < 0 && errno == EINTR)
            continue;
        if (n < 0) {
            result = -errno;
            break;
        }
        if (n == 0) {
            result = -ETIMEDOUT;
            break;
        }
        if (watched.revents & POLLIN)
            break;
        result = -EIO;
    }
    if (result < 0)
        /* An unreaped child PID cannot be reused for an unrelated process. */
        kill(child, SIGKILL);
    if (pidfd >= 0)
        close(pidfd);
    int status = 0;
    pid_t reaped;
    do {
        reaped = waitpid(child, &status, 0);
    } while (reaped < 0 && errno == EINTR);
    if (result < 0)
        return result;
    if (reaped < 0)
        return -errno;
    return WIFEXITED(status) ? WEXITSTATUS(status) : -ECHILD;
}

static int close_dashboard(void) {
    char *const args[] = { VR_COMMAND, "--background", "--hidedashboard", NULL };
    return run_bounded(VR_COMMAND, args, 3000);
}

static void sleep_changed(struct helper *h, bool sleeping) {
    if (sleeping) {
        disarm(h);
        int fd = open(h->log_path, O_RDONLY | O_CLOEXEC | O_NONBLOCK | O_NOFOLLOW);
        struct stat st;
        if (fd < 0 || fstat(fd, &st) < 0 || !S_ISREG(st.st_mode) ||
            lseek(fd, 0, SEEK_END) < 0) {
            if (fd >= 0)
                close(fd);
            puts("Skipping this cycle: SteamVR log unavailable.");
            return;
        }
        h->checkpoint = fd;
        return;
    }
    /* Starting/restarting the service, screen-off and duplicate resume signals
     * never close the dashboard. Disarm before attempting any close request.
     */
    if (h->checkpoint < 0)
        return;
    int fd = h->checkpoint;
    h->checkpoint = -1;
    bool clear = dashboard_untouched(fd, h->log_path);
    close(fd);
    if (!clear) {
        puts("Skipped: dashboard was used, or SteamVR log changed unexpectedly.");
        return;
    }
    if (h->dry_run) {
        puts("Dry run: resume accepted; no dashboard command sent.");
        return;
    }
    puts("Resume detected; sending one dashboard-close request immediately.");
    int result = h->close_action();
    if (result == 0)
        puts("Close request completed. Idle until the next suspend/resume.");
    else
        printf("Close request failed (%d); no retry.\n", result);
}

static int bus_signal(sd_bus_message *message, void *userdata, sd_bus_error *error) {
    (void)error;
    if (strcmp(sd_bus_message_get_signature(message, true), "b") != 0)
        return 0;
    int sleeping;
    if (sd_bus_message_read(message, "b", &sleeping) > 0)
        sleep_changed(userdata, sleeping != 0);
    return 0;
}

int main(int argc, char **argv) {
    setvbuf(stdout, NULL, _IOLBF, 0);
    bool dry_run = argc == 2 && strcmp(argv[1], "--dry-run") == 0;
    if (argc == 2 && strcmp(argv[1], "--version") == 0) {
        puts("Steam Frame Clean Resume " VERSION);
        return 0;
    }
    if (argc != 1 && !dry_run) {
        fputs("Usage: resume-dashboard [--dry-run|--version]\n", stderr);
        return 2;
    }
    const char *user_home = getenv("HOME");
    char *log_path = NULL;
    if (!user_home || user_home[0] != '/' ||
        asprintf(&log_path, "%s/.local/share/Steam/logs/vrwebhelper_systemui.txt", user_home) < 0) {
        fputs("Cannot locate the user's SteamVR log.\n", stderr);
        return 1;
    }
    struct helper h = { .log_path = log_path, .checkpoint = -1,
                       .dry_run = dry_run, .close_action = close_dashboard };
    sd_bus *bus = NULL;
    sd_bus_slot *slot = NULL;
    int result = sd_bus_open_system(&bus);
    if (result < 0)
        goto done;
    result = sd_bus_match_signal(bus, &slot,
        "org.freedesktop.login1", "/org/freedesktop/login1",
        "org.freedesktop.login1.Manager", "PrepareForSleep", bus_signal, &h);
    if (result < 0)
        goto done;
    puts("Ready: native helper waiting for suspend/resume; no polling or inhibitor.");
    (void)sd_notify(0, "READY=1\nSTATUS=Waiting for suspend/resume");
    for (;;) {
        result = sd_bus_process(bus, NULL);
        if (result < 0)
            break;
        if (result > 0)
            continue;
        result = sd_bus_wait(bus, UINT64_MAX);
        if (result < 0 && result != -EINTR)
            break;
    }
done:
    if (result < 0)
        fprintf(stderr, "System bus error: %s\n", strerror(-result));
    disarm(&h);
    sd_bus_slot_unref(slot);
    sd_bus_unref(bus);
    free(log_path);
    return result < 0;
}
FRAME_RESUME_TEXT_0_END
cat > "$stage_dir/frame-resume-dashboard.service" <<'FRAME_RESUME_TEXT_1_END'
# Managed by frame-resume-dashboard
[Unit]
Description=Steam Frame Clean Resume

[Service]
Type=notify
ExecStart=%h/.local/share/frame-resume-dashboard/resume-dashboard
TimeoutStartSec=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
FRAME_RESUME_TEXT_1_END
cat > "$stage_dir/install.sh" <<'FRAME_RESUME_TEXT_2_END'
#!/bin/bash
# Managed by frame-resume-dashboard
set -euo pipefail
if [[ $EUID == 0 ]]; then
    echo 'Run this as your normal Frame user, without sudo.' >&2
    exit 1
fi
package_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
install_dir="$HOME/.local/share/frame-resume-dashboard"
unit_dir="$HOME/.config/systemd/user"
unit_file="$unit_dir/frame-resume-dashboard.service"
[[ $(uname -m) == aarch64 ]] || { echo 'This installer is for Steam Frame (ARM64).' >&2; exit 1; }
[[ -x /opt/steamvr/bin/linuxarm64/vrcmd ]] || { echo 'SteamVR for Frame was not found.' >&2; exit 1; }
"$package_dir/resume-dashboard" --version

# Repeating this exact installation only re-enables the same service.
# A different or unrelated installation is never overwritten.
if [[ -e "$install_dir" || -L "$install_dir" || -e "$unit_file" || -L "$unit_file" ]]; then
    identical=true
    [[ ! -L "$install_dir" && ! -L "$unit_file" && -f "$install_dir/.managed-by-frame-resume-dashboard" ]] || identical=false
    for name in resume-dashboard resume-dashboard.c uninstall.sh; do
        cmp -s -- "$package_dir/$name" "$install_dir/$name" || identical=false
    done
    cmp -s -- "$package_dir/frame-resume-dashboard.service" "$unit_file" || identical=false
    if [[ $identical != true ]]; then
        echo 'An existing installation differs. Uninstall it first, then run this installer again.' >&2
        exit 1
    fi
    systemctl --user daemon-reload
    systemctl --user enable --now frame-resume-dashboard.service
    systemctl --user is-active --quiet frame-resume-dashboard.service
    echo 'Installed. The same native helper is enabled; no duplicate was created.'
    exit 0
fi

cleanup_failed_install() {
    trap - ERR
    systemctl --user disable --now frame-resume-dashboard.service 2>/dev/null || true
    rm -f -- "$unit_file" "$install_dir/resume-dashboard" "$install_dir/resume-dashboard.c" "$install_dir/uninstall.sh" "$install_dir/.managed-by-frame-resume-dashboard"
    rmdir -- "$install_dir" 2>/dev/null || true
    systemctl --user daemon-reload
    echo 'Setup did not complete; its new files were removed.' >&2
    exit 1
}
mkdir -p -- "$install_dir" "$unit_dir"
trap cleanup_failed_install ERR
install -m 755 -- "$package_dir/resume-dashboard" "$install_dir/resume-dashboard"
install -m 644 -- "$package_dir/resume-dashboard.c" "$install_dir/resume-dashboard.c"
install -m 755 -- "$package_dir/uninstall.sh" "$install_dir/uninstall.sh"
touch -- "$install_dir/.managed-by-frame-resume-dashboard"
install -m 644 -- "$package_dir/frame-resume-dashboard.service" "$unit_file"
systemctl --user daemon-reload
systemctl --user enable --now frame-resume-dashboard.service
systemctl --user is-active --quiet frame-resume-dashboard.service
trap - ERR
echo 'Installed. Leave your VR environment running, then suspend and wake to test.'
FRAME_RESUME_TEXT_2_END
cat > "$stage_dir/uninstall.sh" <<'FRAME_RESUME_TEXT_3_END'
#!/bin/bash
# Managed by frame-resume-dashboard
set -euo pipefail
install_dir="$HOME/.local/share/frame-resume-dashboard"
unit_file="$HOME/.config/systemd/user/frame-resume-dashboard.service"
if [[ ! -f "$install_dir/.managed-by-frame-resume-dashboard" ]]; then
    echo 'No managed installation found.'
    exit 0
fi
systemctl --user disable --now frame-resume-dashboard.service
rm -f -- "$unit_file" "$install_dir/resume-dashboard" "$install_dir/resume-dashboard.c" "$install_dir/uninstall.sh" "$install_dir/.managed-by-frame-resume-dashboard"
rmdir -- "$install_dir" 2>/dev/null || true
systemctl --user daemon-reload
systemctl --user reset-failed frame-resume-dashboard.service 2>/dev/null || true
echo 'Uninstalled. Normal dashboard-on-resume behaviour is restored.'
FRAME_RESUME_TEXT_3_END
cat > "$stage_dir/SHA256SUMS.txt" <<'FRAME_RESUME_CHECKSUMS_END'
